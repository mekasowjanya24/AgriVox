# AgriVox Server Environment Variables

# Port to listen on (Render automatically assigns PORT in cloud environments)
PORT=

# MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/agrivox?retryWrites=true&w=majority)
MONGO_URI=

# Secret keys for signing authentication JWT tokens (generate secure random strings)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public URL of your deployed Frontend on Vercel (e.g. https://agrivox.vercel.app)
FRONTEND_URL=
CLIENT_URL=

# Public URL of your deployed Python ML forecasting service on Render (e.g. https://agrivox-ml.onrender.com)
ML_SERVICE_URL=

# Environment mode ('production' in cloud or 'development' locally)
NODE_ENV=

# Optional: Data.gov.in Agmarknet API key for live daily mandi price sync
AGMARKNET_API_KEY=
