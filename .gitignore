# ==========================================
# AgriVox Root .gitignore
# ==========================================

# 1. Environment variables (Protect secrets)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# 2. Node Dependencies & Package managers
node_modules/
*/node_modules/

# 3. Production Builds & Bundler outputs
dist/
build/
*/dist/
*/build/

# 4. Python Virtual Environments & Caches
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# 5. Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
coverage/
*/coverage/
htmlcov/

# 6. Logs & Runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. OS & IDE artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
scratch/
scratch_*
